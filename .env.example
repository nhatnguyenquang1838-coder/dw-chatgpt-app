# Public application origin. Use the production domain for Production and a separate value for Preview.
APP_BASE_URL=https://dw-super-chatgpt-app-complete-v1-dw1407.vercel.app

# GG OAuth client registration.
GG_OAUTH_CLIENT_ID=
GG_OAUTH_CLIENT_SECRET=
GG_OAUTH_CLIENT_AUTH_METHOD=client_secret_basic
GG_OAUTH_AUTHORIZATION_URL=
GG_OAUTH_TOKEN_URL=
GG_OAUTH_REVOCATION_URL=
GG_OAUTH_USERINFO_URL=
GG_OAUTH_SCOPES=openid profile email offline_access
GG_OAUTH_REDIRECT_URI=https://dw-super-chatgpt-app-complete-v1-dw1407.vercel.app/api/auth/gg/callback
GG_API_URL=

# Server-only Supabase persistence. Never expose the service-role key to browser code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Generate independently for each Vercel environment.
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
GG_SESSION_COOKIE_NAME=gg_session_id
GG_SESSION_MAX_AGE_SECONDS=2592000

{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 3008
    }
  },
  "git": {
    "deploymentEnabled": {
      "main": true,
      "test-ua-gwc-001": false
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}

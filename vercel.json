{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 1024,
      "includeFiles": "widget/**"
    },
    "api/auth/gg/*.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "git": {
    "deploymentEnabled": true
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api"
    },
    { "source": "/api/auth/gg/authorize", "destination": "/api/auth/gg/authorize" },
    { "source": "/api/auth/gg/callback", "destination": "/api/auth/gg/callback" },
    { "source": "/api/auth/gg/session", "destination": "/api/auth/gg/session" },
    { "source": "/api/auth/gg/logout", "destination": "/api/auth/gg/logout" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
